{
  "name": "flow-scene-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome Manifest V3 side-panel extension that runs multi-scene image and video generation in Google Flow one scene at a time, waiting for each scene to finish before starting the next.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "package": "node scripts/package.mjs",
    "e2e": "node test/e2e/run.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0"
  }
}
